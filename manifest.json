{
  "manifest_version": 3,
  "name": "Udemy Course Creation Date",
  "version": "1.1",
  "description": "Shows the creation date of Udemy courses",

  "permissions": ["activeTab"],

  "host_permissions": ["https://www.udemy.com/*"],

  "content_scripts": [
    {
      "matches": ["https://www.udemy.com/course/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Udemy Course Date"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
